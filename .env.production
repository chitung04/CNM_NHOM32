# Database Configuration - CẬP NHẬT THÔNG TIN TỪ HOSTING
DB_HOST=localhost
DB_NAME=ten_database_hosting_cua_ban
DB_USER=username_database_hosting
DB_PASS=password_database_hosting

# Application Configuration
APP_ENV=production
APP_DEBUG=false
BASE_URL=https://domain-cua-ban.com

# Session Configuration
SESSION_TIMEOUT=1800

# Security
LOW_STOCK_THRESHOLD=10
EXPIRY_WARNING_DAYS=30

# Paths (không cần thay đổi)
QRCODE_PATH=assets/qrcodes
UPLOAD_PATH=uploads
LOG_PATH=logs